# Stripe Connect (Express). Each business owner connects their own account;
# card payments go directly to them, not through a platform balance.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override for testing against a mock Stripe API.
STRIPE_API_BASE_URL=https://api.stripe.com/v1
